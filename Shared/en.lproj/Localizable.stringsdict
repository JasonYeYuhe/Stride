		<string>%1$@, %2$#@habits@</string>
		<key>habits</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld habit</string>
			<key>other</key>
			<string>%lld habits</string>
		</dict>
	</dict>
	<key>%@ %@: %lld day streak</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@ %2$@: %3$#@days@</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld day streak</string>
