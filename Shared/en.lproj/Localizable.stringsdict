			<string>%lld week streak</string>
		</dict>
	</dict>
	<key>Active Habits (%lld)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Active Habits (%#@count@)</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
	</dict>
	<key>Archived (%lld)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Archived (%#@count@)</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
	</dict>
	<key>%@, %lld day streak, best streak %lld, 30-day rate %lld percent, %lld of the last 14 days completed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@, %2$#@days@, best streak %3$lld, 30-day rate %4$lld percent, %5$lld of the last 14 days completed</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld day streak</string>
			<key>other</key>
			<string>%lld day streak</string>
		</dict>
	</dict>
	<key>%@, %lld week streak, best streak %lld, 30-day rate %lld percent, %lld of the last 14 days completed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@, %2$#@weeks@, best streak %3$lld, 30-day rate %4$lld percent, %5$lld of the last 14 days completed</string>
		<key>weeks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
