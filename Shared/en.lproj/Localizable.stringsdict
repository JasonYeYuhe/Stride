			<key>one</key>
			<string>%lld check-in</string>
			<key>other</key>
			<string>%lld check-ins</string>
		</dict>
	</dict>
	<key>%lld remaining</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@remaining@</string>
		<key>remaining</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld remaining</string>
			<key>other</key>
			<string>%lld remaining</string>
		</dict>
	</dict>
	<key>%lld more habits</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@habits@</string>
		<key>habits</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld more habit</string>
			<key>other</key>
			<string>%lld more habits</string>
		</dict>
	</dict>
	<key>%lld of %lld habits completed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$lld of %2$#@habits@</string>
		<key>habits</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld habit completed</string>
			<key>other</key>
			<string>%lld habits completed</string>
