<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Plural forms (M1, 1.3.0). A key that is here must NOT also be in Localizable.strings: when
  both have it this file wins at runtime (LocalizationCatalogTests proves it), so a copy there
  would be dead text that drifts. en and es choose between one/other; ja, ko, zh-Hans and
  zh-Hant have a single form and are here so every language has the same keys. Keep the six
  files in step. Runtime keys follow Int -> %lld, String -> %@ (RELEASE-1.2.3.md).
-->
<dict>
	<key>%lld day streak</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>連續 %#@days@ 天</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
	</dict>
	<key>%lld week streak</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>連續 %#@weeks@ 週</string>
