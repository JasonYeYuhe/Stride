	<!-- 1.4.1 (M4). The heatmap's VoiceOver summary (D5): completed days of the 84 shown, then
	     the current streak in days, or in weeks for a times-per-week habit. One plural variable
	     per entry: en follows the day total (its streak words are the same for 1 and 2), es
	     follows the streak (the total is always 84). -->
	<key>%lld of %lld days completed, %lld day streak</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$lld 天中完成 %1$lld 天，連續 %3$#@streak@ 天</string>
		<key>streak</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
	</dict>
	<key>%lld of %lld days completed, %lld week streak</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$lld 天中完成 %1$lld 天，連續 %3$#@streak@ 週</string>
		<key>streak</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
	</dict>
	<!-- 1.4.2 (W0): the Wave A copy deck's plurals (RELEASE-1.4.2.md). One plural variable per
	     entry; a key with two arguments gives both their positions (%1$, %2$).
	     - The trial (D4): the button, the Yearly card's label and its terms. The day count comes
	       from the offer's period (a week reads "7 days"); %2$@ is the yearly price.
	     - Insights' record line (D7): the current run is %1$ days (or weeks) short of the
	       habit's longest streak, %2$.
	     - Weekly Review's change against the previous week, in percentage points (D8): "+" for a
	       rise; a drop is passed as a positive number after "−".
	     - Statistics' locked card (D12): how many insights Pro has for this habit, 1 or more. -->
	<key>Start %lld-day free trial</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>開始 %#@days@免費試用</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld 天</string>
		</dict>
	</dict>
	<key>%lld-day free trial</key>
