			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>racha de %lld semana</string>
			<key>other</key>
			<string>racha de %lld semanas</string>
		</dict>
	</dict>
	<key>Active Habits (%lld)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Hábitos activos (%#@count@)</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
	</dict>
	<key>Archived (%lld)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Archivados (%#@count@)</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
	</dict>
	<key>%@, %lld day streak, best streak %lld, 30-day rate %lld percent, %lld of the last 14 days completed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@, %2$#@days@, mejor racha %3$lld, tasa de 30 días %4$lld por ciento, %5$lld de los últimos 14 días completados</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>racha de %lld día</string>
			<key>other</key>
			<string>racha de %lld días</string>
		</dict>
	</dict>
	<key>%@, %lld week streak, best streak %lld, 30-day rate %lld percent, %lld of the last 14 days completed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@, %2$#@weeks@, mejor racha %3$lld, tasa de 30 días %4$lld por ciento, %5$lld de los últimos 14 días completados</string>
