		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
	</dict>
	<key>%@, %lld day streak, best streak %lld, 30-day rate %lld percent, %lld of the last 14 days completed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@，连续 %2$#@days@ 天，最佳连续 %3$lld，30 日完成率百分之 %4$lld，最近 14 天完成 %5$lld 天</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
	</dict>
	<key>%@, %lld week streak, best streak %lld, 30-day rate %lld percent, %lld of the last 14 days completed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@，连续 %2$#@weeks@ 周，最佳连续 %3$lld，30 日完成率百分之 %4$lld，最近 14 天完成 %5$lld 天</string>
		<key>weeks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
	</dict>
	<key>%lld habits</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@habits@ 个习惯</string>
		<key>habits</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
