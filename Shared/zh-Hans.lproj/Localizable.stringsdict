	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@ %2$@：连续 %3$#@days@ 天</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
	</dict>
	<key>%@ %@: %lld week streak</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@ %2$@：连续 %3$#@weeks@ 周</string>
		<key>weeks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
	</dict>
	<key>Active Habits (%lld)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>活跃习惯 (%#@count@)</string>
