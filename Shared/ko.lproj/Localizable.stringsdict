			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
	</dict>
	<key>%lld remaining</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@remaining@개 남음</string>
		<key>remaining</key>
		<dict>
