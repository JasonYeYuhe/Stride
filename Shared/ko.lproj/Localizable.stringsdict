		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
	</dict>
	<key>%@, %lld day streak, best streak %lld, 30-day rate %lld percent, %lld of the last 14 days completed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@, %2$#@days@일 연속, 최고 연속 %3$lld, 30일 달성률 %4$lld퍼센트, 최근 14일 중 %5$lld일 완료</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
	</dict>
	<key>%@, %lld week streak, best streak %lld, 30-day rate %lld percent, %lld of the last 14 days completed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@, %2$#@weeks@주 연속, 최고 연속 %3$lld, 30일 달성률 %4$lld퍼센트, 최근 14일 중 %5$lld일 완료</string>
		<key>weeks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
