<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Plural forms (M1, 1.3.0). A key that is here must NOT also be in Localizable.strings: when
  both have it this file wins at runtime (LocalizationCatalogTests proves it), so a copy there
  would be dead text that drifts. en and es choose between one/other; ja, ko, zh-Hans and
  zh-Hant have a single form and are here so every language has the same keys. Keep the six
  files in step. Runtime keys follow Int -> %lld, String -> %@ (RELEASE-1.2.3.md).
-->
<dict>
	<key>%lld day streak</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@days@日連続</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
	</dict>
	<key>%lld week streak</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@weeks@週連続</string>
		<key>weeks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
	</dict>
	<key>%lld check-ins</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@checkIns@回チェックイン</string>
		<key>checkIns</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
	</dict>
	<key>%lld remaining</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>あと%#@remaining@個</string>
		<key>remaining</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
	</dict>
	<key>%lld more habits</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>他%#@habits@件の習慣</string>
		<key>habits</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
	</dict>
	<key>%lld of %lld habits completed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$lld/%2$#@habits@件の習慣を完了</string>
		<key>habits</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
	</dict>
	<key>%lld of %lld habits completed, %lld percent</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$lld/%2$#@habits@件の習慣を完了、%3$lldパーセント</string>
		<key>habits</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
	</dict>
	<key>🔥 All %lld habits done!</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>🔥 %#@habits@個の習慣すべて完了！</string>
		<key>habits</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
	</dict>
