	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>アーカイブ済み (%#@count@)</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
	</dict>
	<key>%@, %lld day streak, best streak %lld, 30-day rate %lld percent, %lld of the last 14 days completed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@、%2$#@days@日連続、最長記録%3$lld、30日達成率%4$lldパーセント、直近14日のうち%5$lld日完了</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
	</dict>
	<key>%@, %lld week streak, best streak %lld, 30-day rate %lld percent, %lld of the last 14 days completed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@、%2$#@weeks@週連続、最長記録%3$lld、30日達成率%4$lldパーセント、直近14日のうち%5$lld日完了</string>
		<key>weeks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
	</dict>
	<key>%lld habits</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@habits@件の習慣</string>
		<key>habits</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
