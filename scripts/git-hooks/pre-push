#!/bin/bash
# pre-push: before commits that touch the Apple side leave this Mac, build them for a generic
# iOS device and check the product — the same scripts CI runs (scripts/ci/).
#
# Installed by scripts/install-git-hooks.sh (sets core.hooksPath to scripts/git-hooks).
# Skip once with:  SKIP_STRIDE_HOOKS=1 git push
#
# Why a hook as well as CI: releases are built with Xcode 27, and the only GitHub image
# carrying it is a preview (runs-on: xcode-27). If that image queues for hours or disappears,
# this is the gate that still stops a push whose app has lost its widget extension or a
# privacy manifest — the 1.2.x class of bug, which a green compile does not catch.
#
# What it builds is the PUSHED COMMIT, checked out on its own (git worktree add --detach) into
# a temporary directory, never the working tree. Until 1.3.1 it built the working tree, after
# checking once that the Apple paths there equalled the commit; on 2026-09-28 it built another
# agent's half-finished, uncommitted edits in the shared checkout and passed — a check made
# before minutes of building says nothing about what the compiler then reads, and it vouched
# for a tree nobody was pushing. A checkout of the commit also catches what a working-tree
# build never can: a source file that exists here but was never `git add`ed.
#
# Speed: derived data persists across pushes (~/Library/Developer/Xcode/DerivedData/
# Stride-prepush), and the checkout goes to the SAME path every time, so Xcode reuses its build
# description, the resolved packages and the built Sentry framework. Every file of the fresh
# checkout is new to the compiler, so the app itself recompiles (see the timing it prints).
set -uo pipefail

if [[ "${SKIP_STRIDE_HOOKS:-}" == "1" ]]; then
    echo "pre-push: SKIP_STRIDE_HOOKS=1 — skipping the iOS build check."
    exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
CI="$ROOT/scripts/ci"
DERIVED="${STRIDE_HOOK_DERIVED_DATA:-$HOME/Library/Developer/Xcode/DerivedData/Stride-prepush}"
# The pushed commit is checked out here — one fixed path, not a fresh mktemp name, because
# derived data is keyed by source paths: a new path each push would be a cold build each push.
TREE="${STRIDE_HOOK_TREE:-${TMPDIR:-/tmp}/stride-prepush-tree}"
TREE="${TREE%/}"
# It is removed with rm -rf before and after every run, so a bad override must not reach that.
case "$TREE" in
    ""|"$HOME"|"$ROOT"|"$ROOT"/*) echo "pre-push: ✗ refusing STRIDE_HOOK_TREE='$TREE'."; exit 1 ;;
esac
ZERO="0000000000000000000000000000000000000000"

# stdin: "<local ref> <local sha> <remote ref> <remote sha>" per ref being pushed.
target=""
while read -r local_ref local_sha remote_ref remote_sha; do
    [[ "$local_sha" == "$ZERO" ]] && continue          # deleting a remote branch
    # An annotated tag arrives as the tag OBJECT's sha, not its commit's. Unpeeled, the release
    # push (`git push origin main v1.3.0`, or --follow-tags) looked like two different trees
    # with Apple changes and was refused. Peel to the commit; a tag of a non-commit keeps its sha.
    local_sha="$(git rev-parse -q --verify "${local_sha}^{commit}" 2>/dev/null || echo "$local_sha")"
    base="$remote_sha"
    if [[ "$base" == "$ZERO" ]]; then
        # New remote branch: compare with where it leaves main.
        base="$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "$ZERO")"
    fi
    # The Apple-paths filter: one list, in changed_areas.sh, shared with CI.
    # Captured, not piped into `grep -q`: grep exiting early can SIGPIPE the script, and
    # under pipefail that turns a match into a failure.
    areas="$("$CI/changed_areas.sh" "$base" "$local_sha")"
    if [[ "$areas" == *"apple=true"* ]]; then
        if [[ -n "$target" && "$target" != "$local_sha" ]]; then
            echo "pre-push: several refs with Apple changes in one push; push them one at a time"
            echo "          (or SKIP_STRIDE_HOOKS=1) — the hook builds one tree."
            exit 1
        fi
        target="$local_sha"
    fi
done

[[ -z "$target" ]] && exit 0   # nothing on the Apple side: nothing to build

echo "pre-push: Apple paths changed in $(git rev-parse --short "$target") — building that commit for generic iOS."

# Git runs hooks with GIT_DIR (and sometimes GIT_INDEX_FILE) exported for THIS checkout.
# Left set, every git command in the scripts below — the drift check's `git diff` — would
# read the main checkout's index instead of the temporary one.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX

# One run at a time: the checkout path and derived data are shared. mkdir is the atomic test.
LOCK="$TREE.lock"
if ! mkdir "$LOCK" 2>/dev/null; then
    echo "pre-push: ✗ another pre-push is building ($LOCK exists). If none is running, a killed"
    echo "          one left it behind: rmdir '$LOCK' and push again (or SKIP_STRIDE_HOOKS=1)."
    exit 1
fi
remove_tree() {
    git -C "$ROOT" worktree remove --force "$TREE" >/dev/null 2>&1
    rm -rf "$TREE"
    git -C "$ROOT" worktree prune >/dev/null 2>&1
}
cleanup() { remove_tree; rmdir "$LOCK" 2>/dev/null; }
trap cleanup EXIT
trap 'exit 130' INT TERM HUP   # through the EXIT trap, so ^C still removes the checkout

remove_tree   # a checkout left by a hook that was killed outright (kill -9, a crash)
if ! git -C "$ROOT" worktree add --detach --quiet "$TREE" "$target"; then
    echo "pre-push: ✗ could not check out $(git -C "$ROOT" rev-parse --short "$target") into $TREE."
    exit 1
fi
CI="$TREE/scripts/ci"   # the pushed commit's own checks, as CI would run them for it

# Drift check only with the pinned XcodeGen (exit 3 = other version): a different version
# writes a different project, and "regenerate with the wrong tool" is not a useful failure.
# It regenerates inside the temporary checkout and compares with the commit there.
"$CI/check_xcodegen_drift.sh"
case $? in
    0) ;;
    3) echo "pre-push: (XcodeGen drift check skipped — install XcodeGen 2.45.3 to run it)" ;;
    *) echo "pre-push: ✗ Stride.xcodeproj is out of date; see above."; exit 1 ;;
esac

start=$(date +%s)
if ! "$CI/build_ios_generic.sh" "$DERIVED"; then
    echo "pre-push: ✗ iOS build or product check failed for $(git -C "$ROOT" rev-parse --short "$target") — push aborted."
    echo "          (SKIP_STRIDE_HOOKS=1 to override.)"
    exit 1
fi
echo "pre-push: ✓ iOS build and product check of $(git -C "$ROOT" rev-parse --short "$target") passed in $(( $(date +%s) - start ))s."
