PORT=3002
NODE_ENV=development
# The origin this server answers on: CORS allowlist AND the host in magic-link emails.
# It must serve GET /login (this process does). See origins.js.
FRONTEND_ORIGIN=https://stride-api.colorarchive.me
RESEND_API_KEY=re_xxxx
FROM_EMAIL=Stride <hello@strideapp.me>

# Demo account login token for App Store review (used by seed-demo.js).
# Set a long random value here; re-running seed-demo.js installs it and revokes
# the previous one. If unset, seed-demo.js generates a random token and prints it.
DEMO_TOKEN=

# Sync pause switch (lib/syncPause.js; all optional, read on every request).
# Prefer the flag file: `touch SYNC_PAUSED` in the server directory pauses sync (503
# sync_paused), `rm` resumes, no restart. An integer inside it is the Retry-After in seconds.
# SYNC_PAUSED=1 does the same from the environment (needs `pm2 restart --update-env`).
# SYNC_PAUSED=
# SYNC_PAUSE_FILE=/root/stride-server/SYNC_PAUSED
# SYNC_PAUSE_RETRY_AFTER_SECONDS=900

# Rate limits (lib/rateLimits.js; optional, defaults shown).
# SYNC_RATE_LIMIT_PER_MIN=60                  per account, /v1/sync and /sync
# SYNC_AUTH_FAILURE_LIMIT_PER_15MIN=100       per IP, sync requests without a valid session
# GLOBAL_RATE_LIMIT_PER_15MIN=100             per IP, everything except sync

# Observability (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Datadog APM auto-inits when NODE_ENV != test; configure with standard DD_* vars
# DD_SERVICE=stride-server
# DD_ENV=production
