PORT=3002
NODE_ENV=development
# The origin this server answers on: CORS allowlist AND the host in magic-link emails.
# It must serve GET /login (this process does). See origins.js.
FRONTEND_ORIGIN=https://stride-api.colorarchive.me
RESEND_API_KEY=re_xxxx
FROM_EMAIL=Stride <hello@strideapp.me>

# Demo account login token for App Store review (used by seed-demo.js).
# Set a long random value here; re-running seed-demo.js installs it and revokes
# the previous one. If unset, seed-demo.js generates a random token and prints it.
DEMO_TOKEN=

# Observability (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Datadog APM auto-inits when NODE_ENV != test; configure with standard DD_* vars
# DD_SERVICE=stride-server
# DD_ENV=production
